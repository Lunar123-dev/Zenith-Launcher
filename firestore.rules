rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidFamily(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'ownerId', 'ownerEmail', 'memberUids', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.code is string && data.code.size() > 0 && data.code.size() <= 32
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.ownerEmail is string && data.ownerEmail.size() <= 256
        && data.memberUids is list && data.memberUids.size() <= 50
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDevice(data) {
      return data.keys().hasAll([
        'id', 'userId', 'userEmail', 'userName', 'familyId', 'familyCode',
        'memberUids', 'deviceName', 'deviceModel', 'deviceType',
        'batteryLevel', 'isCharging', 'ramUsedMb', 'ramTotalMb',
        'networkType', 'networkName', 'isOnline',
        'remoteMessage', 'remoteMessageSender', 'ringAlert',
        'createdAt', 'updatedAt'
      ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 256
        && data.userName is string && data.userName.size() <= 128
        && data.familyId is string && data.familyId.size() <= 128
        && data.familyCode is string && data.familyCode.size() <= 32
        && data.memberUids is list && data.memberUids.size() <= 50
        && data.deviceName is string && data.deviceName.size() <= 128
        && data.deviceModel is string && data.deviceModel.size() <= 128
        && data.deviceType is string && data.deviceType.size() <= 32
        && data.batteryLevel is int && data.batteryLevel >= -1 && data.batteryLevel <= 100
        && data.isCharging is bool
        && data.ramUsedMb is int && data.ramUsedMb >= 0
        && data.ramTotalMb is int && data.ramTotalMb >= 0
        && data.networkType is string && data.networkType.size() <= 64
        && data.networkName is string && data.networkName.size() <= 128
        && data.isOnline is bool
        && data.remoteMessage is string && data.remoteMessage.size() <= 500
        && data.remoteMessageSender is string && data.remoteMessageSender.size() <= 128
        && data.ringAlert is bool
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Collection: families
    match /families/{familyId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.memberUids
        || (resource.data.code != null && resource.data.code.size() > 0)
      );

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && isValidFamily(request.resource.data);

      allow update: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids)
        && isValidFamily(request.resource.data);

      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    // Collection: devices
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.memberUids
      );

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidDevice(request.resource.data);

      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.memberUids)
        && isValidDevice(request.resource.data);

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}
