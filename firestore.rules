rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cho phép nhóm gia đình đọc và tìm kiếm theo mã code, tạo và cập nhật thành viên
    match /families/{familyId} {
      allow read, write: if true;
    }

    // Cho phép đồng bộ trạng thái thiết bị và gửi thông báo tìm thiết bị
    match /devices/{deviceId} {
      allow read, write: if true;
    }
  }
}

